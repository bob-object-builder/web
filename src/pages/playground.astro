---
import Editor from "@/components/ui/editor/Editor.astro";
import Layout from "@/layouts/Layout.astro";
import getContent from "@/lib/i18n/get-content";
const t = await getContent("main");
---

<Layout>
  <section class="flex flex-col gap-8 h-full">
    <h1
      class="text-white text-4xl font-bold text-center"
      set:html={t("playground.title")}
    />

    <Editor />
  </section>
</Layout>
