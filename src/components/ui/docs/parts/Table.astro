---
import BobCode from "@/components/ui/editor/BobCode.astro";
import Groups from "@/components/ui/docs/Groups.astro";
import getContent from "@/lib/i18n/get-content";

const t = await getContent("docs/table");
---

<section id="table" class="grid scroll-m-8">
  <div class="mb-12">
    <h2 class="text-3xl font-bold text-center mb-6">{t("title")}</h2>
    <p class="text-lg text-center text-balance" set:html={t("introduction")} />
  </div>

  <div class="grid md:grid-cols-[.5fr_1fr] gap-6">
    <div>
      <h3 class="text-xl font-semibold mb-3 text-bob">Supported Types</h3>

      <Groups
        groups={[
          { title: "Numerics", types: t("types.numerics") },
          { title: "Text", types: t("types.text") },
          { title: "Aliases", types: t("types.aliases") },
          { title: "Booleans", types: t("types.booleans") },
          { title: "Temporal", types: t("types.temporal") },
        ]}
      />
    </div>

    <BobCode code={t("example")} />
  </div>
</section>
