---
type GroupType = string | { type: string; attributes: string[] };

type Group = {
  title: string;
  types: GroupType[];
};

interface Props {
  groups?: Group[];
}

const { groups = [] }: Props = Astro.props;

const groupStyles = [
  {
    border: "border-blue-400/40",
    hover: "hover:border-blue-400",
    bg: "bg-blue-900/20",
    hoverBg: "hover:bg-blue-900/30",
  },
  {
    border: "border-green-400/40",
    hover: "hover:border-green-400",
    bg: "bg-green-900/20",
    hoverBg: "hover:bg-green-900/30",
  },
  {
    border: "border-purple-400/40",
    hover: "hover:border-purple-400",
    bg: "bg-purple-900/20",
    hoverBg: "hover:bg-purple-900/30",
  },
  {
    border: "border-yellow-300/40",
    hover: "hover:border-yellow-300",
    bg: "bg-yellow-900/20",
    hoverBg: "hover:bg-yellow-900/30",
  },
  {
    border: "border-pink-400/40",
    hover: "hover:border-pink-400",
    bg: "bg-pink-900/20",
    hoverBg: "hover:bg-pink-900/30",
  },
];
---

<div class="flex flex-col gap-6">
  {
    groups.map((group: Group, i: number) => {
      const style = groupStyles[i % groupStyles.length];
      return (
        <div>
          <h4 class="text-lg font-semibold mb-2 text-white/90">
            {group.title}
          </h4>
          <ul class="flex flex-wrap gap-3">
            {(group.types ?? []).map((t: GroupType) => {
              const typeName = typeof t === "string" ? t : t.type;
              const attributes = typeof t === "string" ? [] : t.attributes;

              return (
                <li
                  class={`
                  ${style.bg} ${style.border} ${style.hover} ${style.hoverBg}
                  text-white/90 px-4 py-2 rounded-lg font-mono text-sm tracking-wide
                  border transition-all duration-300 ease-in-out shadow-sm
                  hover:shadow-md cursor-default flex flex-col flex-wrap gap-1 items-start
                `}
                >
                  <span class="font-bold">{typeName}</span>
                  {attributes.length > 0 && (
                    <ul class="flex gap-1 flex-wrap">
                      {attributes.map((attr) => (
                        <li class="text-xs text-white/70 bg-white/10 px-2 py-0.5 rounded-full">
                          {attr}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      );
    })
  }
</div>
